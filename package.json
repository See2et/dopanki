{
  "name": "dopanki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev --ip 127.0.0.1",
    "dev:lan": "npm run build:web && tsx src/tools/dev-lan.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "build": "npm run build:web && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --exclude 'tests/e2e/**' --exclude '.local/**' --exclude '.astraeus/**'",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply dopanki --local",
    "import:anki": "tsx src/tools/import-anki.ts",
    "deploy": "npm run build:web && wrangler deploy --env production"
  },
  "dependencies": {
    "hono": "4.13.12",
    "jose": "^6.2.12",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.45.0"
  }
}
